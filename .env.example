DATABASE_URL="postgresql://user:password@localhost:5432/kingbrake?schema=public"

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu-secreto-generado-con-openssl
GOOGLE_CLIENT_ID=tu-client-id-de-google
GOOGLE_CLIENT_SECRET=tu-client-secret-de-google

# Genera un secreto con: openssl rand -base64 32
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Cloudinary (para subir imágenes de productos y blog)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Envio de correos
RESEND_API_KEY=re_
EMAIL_FROM=contacto@kingbrake.com

# Google Maps / Places API
# https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key-de-google-maps

# API Key para servicios externos
# Genera con: openssl rand -hex 32
EXTERNAL_API_KEY=
